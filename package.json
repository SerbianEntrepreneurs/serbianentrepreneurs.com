{
  "name": "se-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check --error-on-warnings src",
    "format": "biome check --write src",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,json}": ["biome format --no-errors-on-unmatched --write"]
  },
  "dependencies": {
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9",
    "lint-staged": "^15",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
